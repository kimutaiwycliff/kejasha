# Serves the static export inside the docs image; TLS is terminated by the edge Caddy.
:80 {
	root * /srv
	encode zstd gzip
	try_files {path} {path}.html {path}/index.html
	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
	header Content-Security-Policy "frame-ancestors 'none'"
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
