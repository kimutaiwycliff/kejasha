{
  "name": "@kejasha/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "spec": "tsx scripts/gen-spec.ts",
    "spec:check": "tsx scripts/gen-spec.ts --check",
    "spec:lint": "tsx scripts/lint-spec.ts && redocly lint openapi.json --config ../../redocly.yaml",
    "build": "node ../../scripts/build-app.mjs . src/server.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@kejasha/config": "workspace:^",
    "@kejasha/contracts": "workspace:^",
    "@kejasha/core": "workspace:^",
    "@kejasha/db": "workspace:^",
    "@kejasha/integrations-storage": "workspace:^",
    "@kejasha/jobs": "workspace:^",
    "@scalar/fastify-api-reference": "^1.75.1",
    "@sentry/node": "^11.8.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "find-my-way": "^9.6.0",
    "ioredis": "5",
    "openapi-types": "^12.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kejasha/api-client": "workspace:^"
  }
}
