NODE_ENV=development
LOG_LEVEL=info

# Domain — the ONLY place the domain is set (ADR-016).
# URLs below default to https://api.${APP_DOMAIN} / https://app.${APP_DOMAIN} when unset.
APP_DOMAIN=localhost
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Extra domains still accepted during a domain migration (comma-separated, optional)
LEGACY_DOMAINS=
API_PORT=4000
# Proxies allowed to set X-Forwarded-For: 'loopback' locally; hop count or CIDRs in production.
TRUST_PROXY=loopback

# app_owner: migrations + admin (BYPASSRLS). app_authenticated: tenant pool (RLS enforced).
DATABASE_URL=postgresql://app_owner:secret@localhost:5432/kejasha?sslmode=disable
DATABASE_AUTHENTICATED_URL=postgresql://app_authenticated:secret@localhost:5432/kejasha?sslmode=disable
APP_AUTHENTICATED_PASSWORD=secret
REDIS_URL=redis://localhost:6379

# Dev-only value; production uses a 32+ byte random secret from the secrets store.
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me-0123456789
BETTER_AUTH_URL=

# Envelope encryption key for per-landlord Daraja credentials (32 bytes base64)
# Dev-only key (32 bytes, base64). Production: a fresh random key from the secrets store.
CREDENTIALS_MASTER_KEY=ZGV2LW9ubHktY3JlZGVudGlhbHMta2V5LTMyYnl0ZXM=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Dev: SeaweedFS from infra/compose.yml (keys match infra/seaweedfs/s3.json).
# Prod: Cloudflare R2 — S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto (ADR-019).
S3_ACCESS_KEY=kejasha-dev
S3_SECRET_KEY=kejasha-dev-secret
S3_BUCKET_FILES=kejasha-files
S3_BUCKET_BACKUPS=kejasha-backups

RESEND_API_KEY=
EMAIL_FROM=

AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_WHATSAPP_CHANNEL=

DARAJA_ENV=sandbox
# Optional: comma-separated Safaricom callback IPs to accept (empty = any; the channel token still gates).
DARAJA_CALLBACK_IPS=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

CRON_SECRET=
GLITCHTIP_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
