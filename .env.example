NODE_ENV=development
LOG_LEVEL=info

# Domain — the ONLY place the domain is set (ADR-016).
# URLs below default to https://api.${APP_DOMAIN} / https://app.${APP_DOMAIN} when unset.
APP_DOMAIN=localhost
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Extra domains still accepted during a domain migration (comma-separated, optional)
LEGACY_DOMAINS=
API_PORT=4000

# app_owner: migrations + admin (BYPASSRLS). app_authenticated: tenant pool (RLS enforced).
DATABASE_URL=postgresql://app_owner:secret@localhost:5432/kejasha?sslmode=disable
DATABASE_AUTHENTICATED_URL=postgresql://app_authenticated:secret@localhost:5432/kejasha?sslmode=disable
APP_AUTHENTICATED_PASSWORD=secret
REDIS_URL=redis://localhost:6379

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Envelope encryption key for per-landlord Daraja credentials (32 bytes base64)
CREDENTIALS_MASTER_KEY=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_FILES=kejasha-files
S3_BUCKET_BACKUPS=kejasha-backups

RESEND_API_KEY=
EMAIL_FROM=

AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_WHATSAPP_CHANNEL=

DARAJA_ENV=sandbox

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

CRON_SECRET=
GLITCHTIP_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
